{
  "name": "ghost-bot",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @ghost-bot/desktop dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint packages apps tests",
    "test": "node --test tests/*.test.ts",
    "package:linux": "pnpm --filter @ghost-bot/desktop package:linux",
    "package:appimage": "pnpm --filter @ghost-bot/desktop package:appimage",
    "package:rpm": "pnpm --filter @ghost-bot/desktop package:rpm",
    "verify:offline": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/verify-phase-2e-acceptance.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.2",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1"
  }
}
